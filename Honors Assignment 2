Part 1:

class Employee:
    def __init__(self, name, number):
        self.name = name
        self.number = number

    def set_name(self, name):
        self.name = name

    def set_number(self, number):
        self.number = number

    def get_name(self):
        return self.name

    def get_number(self):
        return self.number


class ProductionWorker(Employee):
    def __init__(self, name, number, shift, pay_rate):
        super().__init__(name, number)
        self.shift = shift
        self.pay_rate = pay_rate

    def set_shift(self, shift):
        self.shift = shift

    def set_pay_rate(self, pay_rate):
        self.pay_rate = pay_rate

    def get_shift(self):
        return self.shift

    def get_pay_rate(self):
        return self.pay_rate


def main():
    name = input("Enter employee name: ")
    number = input("Enter employee number: ")
    shift = int(input("Enter shift (1 for day, 2 for night): "))
    pay_rate = float(input("Enter hourly pay rate: "))

    worker = ProductionWorker(name, number, shift, pay_rate)

    print("\nEmployee Information")
    print("Name:", worker.get_name())
    print("Employee Number:", worker.get_number())
    print("Shift:", worker.get_shift())
    print("Hourly Pay Rate: $", format(worker.get_pay_rate(), ".2f"), sep="")


main ()

