import tkinter as tk
from tkinter import messagebox


def calculate_charge():
    minutes = float(minutes_entry.get())
    rate = rate_choice.get()

    total = minutes * rate

    messagebox.showinfo("Call Charge", f"Total charge: ${total:.2f}")


window = tk.Tk()
window.title("Telephone Call Charges")
window.geometry("350x300")

tk.Label(window, text="Select a calling rate:").pack(pady=10)

rate_choice = tk.DoubleVar(value=0.07)

tk.Radiobutton(window, text="Daytime ($0.07)", variable=rate_choice, value=0.07).pack()
tk.Radiobutton(window, text="Evening ($0.12)", variable=rate_choice, value=0.12).pack()
tk.Radiobutton(window, text="Off-Peak ($0.05)", variable=rate_choice, value=0.05).pack()

tk.Label(window, text="Enter the number of minutes:").pack(pady=10)

minutes_entry = tk.Entry(window)
minutes_entry.pack()

tk.Button(window, text="Calculate Charge", command=calculate_charge).pack(pady=15)

window.mainloop()

