import tkinter as tk
from tkinter import messagebox


def calculate_tax():
    actual_value = float(value_entry.get())

    assessed_value = actual_value * 0.60
    property_tax = assessed_value / 100 * 0.75

    messagebox.showinfo("Property Tax",
                        f"Assessed Value: ${assessed_value:.2f}\n"
                        f"Property Tax: ${property_tax:.2f}")


window = tk.Tk()
window.title("Property Tax Calculator")
window.geometry("350x200")

tk.Label(window, text="Enter the actual property value:").pack(pady=15)

value_entry = tk.Entry(window)
value_entry.pack()

tk.Button(window, text="Calculate Tax", command=calculate_tax).pack(pady=20)

window.mainloop()
