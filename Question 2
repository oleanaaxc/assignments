def tally_scores(filename):
    with open(filename, 'r') as file:
        for line in file:
            parts = line.split()
            name = parts[0]

            total = 0
            count = 0

            for score in parts[1:]:
                total += int(score)
                count += 1

            average = total / count

            print(name + ":", " ".join(parts[1:]))
            print("average =", average)
