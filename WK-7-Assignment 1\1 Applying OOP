class QueueError(IndexError):
    pass


class Queue:
    def __init__(self):
        self.__queue = []

    def put(self, elem):
        self.__queue.insert(0, elem)

    def get(self):
        if len(self.__queue) == 0:
            raise QueueError

        return self.__queue.pop()

    def isempty(self):
        return len(self.__queue) == 0


class SuperQueue(Queue):
    def isempty(self):
        return super().isempty()


que = SuperQueue()

que.put(1)
que.put("dog")
que.put(False)

for i in range(4):
