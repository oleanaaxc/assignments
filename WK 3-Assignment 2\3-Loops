text = input("Enter a sentence: ")

text = text.lower()

total = 0

for letter in text:
    if letter.isalpha():
        total = total + 1

print("Total letters:", total)

for letter in "abcdefghijklmnopqrstuvwxyz":
    count = 0

    for character in text:
        if character == letter:
            count = count + 1

    if count > 0:
        print(letter, "=", count)

