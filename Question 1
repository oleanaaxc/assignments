def word_stats(filename):
    with open(filename, 'r') as file:
        text = file.read()

    words = text.split()
    total_words = len(words)

    total_letters = 0
    for word in words:
    total_letters += len(word)

    average_length = total_letters / total_words

    print("Total words =", total_words)
    print("Average length =", average_length)
